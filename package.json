{
  "name": "restaurant-pos",
  "version": "0.4.0",
  "description": "RestoNiti desktop POS and operations app for a single restaurant.",
  "author": "RestoNiti",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "start": "concurrently \"npm:dev:electron\" \"npm:dev:react\"",
    "dev:electron": "node scripts/start-electron-dev.cjs",
    "dev:react": "vite --port 5173",
    "generate:icon": "node scripts/generate-icon.cjs",
    "build:renderer": "npm run generate:icon && vite build",
    "build:electron": "npm run generate:icon && tsc --project tsconfig.electron.json && electron-builder",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "build:electron:system-ca": "cross-env NODE_OPTIONS=--use-system-ca npm run build:electron",
    "build": "rimraf dist dist-electron build && npm run build:renderer && npm run build:electron:system-ca",
    "package": "npm run build",
    "lint": "eslint --ext .ts,.tsx src/ electron/ && node scripts/check-theme-tokens.cjs",
    "test": "jest",
    "perf:seed": "node scripts/perf-seed.cjs",
    "perf:reports": "node scripts/perf-reports.cjs",
    "perf:app": "node scripts/perf-reports.cjs",
    "perf:ui": "node scripts/perf-ui.cjs",
    "perf": "npm run perf:seed && npm run perf:app",
    "audit": "npm audit --audit-level=low",
    "audit:json": "npm audit --json > audit.json",
    "audit:fix": "npm audit fix"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "module": "CommonJS",
          "moduleResolution": "Node",
          "types": [
            "node",
            "jest"
          ]
        }
      }
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.7.0",
    "electron-builder": "^26.8.1",
    "electron-devtools-installer": "^4.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "events": "^3.3.0",
    "inherits": "^2.0.4",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "util": "^0.12.5",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "better-sqlite3": "^12.10.0",
    "lucide-react": "^1.28.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.restaurant-pos.app",
    "productName": "RestoNiti",
    "npmRebuild": true,
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
