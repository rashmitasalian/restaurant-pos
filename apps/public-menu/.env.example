# Optional. Unused in the demo — the menu is served from local data.
# Future: GET ${VITE_PUBLIC_MENU_API_URL}/api/public/menu/:restaurantSlug
VITE_PUBLIC_MENU_API_URL=

# Public origin encoded into QR codes. No trailing slash.
# If unset, the app uses window.location.origin (local / LAN only).
VITE_PUBLIC_MENU_BASE_URL=https://menu.restoniti.com
