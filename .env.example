# Restaurant POS environment configuration
# Copy to .env and adjust for the target machine.

NODE_ENV=development
LOG_LEVEL=info

# Business identity
VITE_HOTEL_NAME=Your Restaurant Name
VITE_HOTEL_INITIALS=YR
VITE_HOTEL_PHONE=
VITE_HOTEL_EMAIL=
VITE_APP_NAME=Restaurant POS
HOTEL_NAME=Your Restaurant Name

# Tax and currency
VITE_CURRENCY_LOCALE=en-IN
VITE_CURRENCY_CODE=INR

# Tables — default count when creating tables from Settings (not auto-seeded on install)
VITE_TABLE_COUNT=12

# SQLite database name shown only for renderer compatibility.
# The actual SQLite file is owned by Electron main under userData/data.
VITE_DB_NAME=restaurant-pos.sqlite

# Authentication and session
VITE_SESSION_KEY=pos-session
VITE_SESSION_INACTIVITY_MS=1800000
VITE_AUTH_MAX_ATTEMPTS=5
VITE_AUTH_LOCKOUT_MS=900000

# Printer configuration
# Network printers can be configured in Settings by IPv4 address.
# USB printers should be installed in Windows and configured by their Windows printer name.
KITCHEN_PRINTER_USB_NAME=POS-80C
COUNTER_PRINTER_USB_NAME=POS-80C
PRINTER_PORT=9100
VITE_PRINTER_PORT=9100

# Developer options
INSTALL_REACT_DEVTOOLS=0
